<Project>

  <!--
    Sandbox switch "fail_restore" (TS-S16, TS-S18): points restore at a feed that does not
    exist, with an empty packages folder so nothing can come from the local cache.
    MSBuild cannot parse JSON, so the switch is matched with a regular expression.
  -->
  <PropertyGroup>
    <SandboxJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)sandbox.json'))</SandboxJson>
    <SandboxFailRestore>$([System.Text.RegularExpressions.Regex]::IsMatch($(SandboxJson), '"fail_restore"\s*:\s*true'))</SandboxFailRestore>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SandboxFailRestore)' == 'True'">
    <RestoreSources>https://nuget.unreachable.invalid/v3/index.json</RestoreSources>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).sandbox-empty-packages</RestorePackagesPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!--
      One CTRF report per project, matching the default results_glob **/TestResults/*.ctrf.json (ADR-007, ADR-021).
      xUnit 4.x names the option after its result writer; 3.x used report-ctrf. Every project writes to the one
      TestResults folder at the repo root, so the file name must differ per project.
    -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --report-xunit-ctrf --report-xunit-ctrf-filename $(MSBuildProjectName).ctrf.json</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <Using Include="Xunit" />
    <Compile Include="$(MSBuildThisFileDirectory)tests/Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
